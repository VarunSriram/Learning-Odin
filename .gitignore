# -------------------------------------------------------------------------
# Odin Build Artifacts
# -------------------------------------------------------------------------
# Executables
*.exe
*.bin
*.elf
*.out

# Object files and static libraries
*.o
*.obj
*.lib
*.a

# Shared libraries / Dynamic Link Libraries
*.dll
*.so
*.dylib

